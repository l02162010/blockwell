{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/schema": {
      "entry": [
        "src/index.ts",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/index.ts",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/vue": {
      "entry": [
        "src/index.ts",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ]
    },
    "apps/playground": {
      "entry": [
        "e2e/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ]
    },
    "apps/site": {
      "entry": [],
      "project": [
        "src/**/*.{ts,vue}"
      ]
    },
    "apps/docs": {
      "project": [
        ".vitepress/**/*.{ts,vue}"
      ]
    }
  },
  "ignoreWorkspaces": [
    "go",
    "rust",
    "dotnet"
  ],
  "ignoreDependencies": [
    "@arethetypeswrong/cli"
  ]
}
